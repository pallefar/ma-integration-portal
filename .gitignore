# Dependencies — committed so `node server.js` runs with no `npm install`.
# (node_modules/ intentionally NOT ignored.)

# Large / unrelated artifacts
ma-portal.zip
*.zip
looxmaxing/

# Runtime + OS
*.log
npm-debug.log*
.DS_Store

# Database runtime artifacts (atomic-write temp + rolling backup)
db.json.tmp
db.json.bak

# SQLite runtime sidecars (WAL/SHM + rolling backup) — the primary data/*.db
# file itself is committed (demo database), same precedent as db.json above.
data/*.db-wal
data/*.db-shm
data/*.db.bak

# Migration script's in-progress temp DB (+ WAL/SHM sidecars) — normally
# renamed away on success and cleaned up at the start of the next run on
# failure, but ignored here too as a belt-and-suspenders guard against ever
# committing an orphaned, potentially PII-containing partial data dump.
data/.*.migrating-*

# Phase 3 (Deal Isolation, Audit Log & Write Validation, D-07/D-09): these
# three families hold live, churning material — session tokens, compliance
# history, and real-deal MNPI — and must NEVER reach git, unlike data/demo.db
# and data/control.db above (which stay committed, near-static, for the
# zero-install boot with pre-seeded demo accounts). This section lands BEFORE
# any of those files can exist (T-03-01), matching Phase 1's .db precedent.
data/runtime.db*
data/audit.db*
data/deals/

# Uploaded media (runtime-generated)
public/uploads/

# Local dev / verification artifacts
.playwright-mcp/
/*.png
/*.jpeg
/*.jpg

# Source deck (converted to public/playbook/*.pdf which IS served/committed)
HR M&A Guidebook_03.2026.pptx

# Source slide deck (served copies committed under public/overview-deck/)
slidedeck interaction/

# graphify build output (regenerable via `graphify update .`; persistent copy lives in .planning/graphs/)
graphify-out/

# Outbound email log (runtime-generated, real-deal correspondence — this repo
# is PUBLIC): server.js's own /api/admin/download-zip exclusion list already
# treats this directory as secret-bearing and writes real outbound comms
# into it at runtime. Uses the CONTENTS-glob form (dir/*), not the bare
# directory form — git cannot re-include a file whose parent directory is
# itself excluded, so the bare form would silently untrack the one
# pre-existing demo email below. That file is referenced by a communications
# record in the committed data/demo.db and db.json, and the demonstration
# showcase (CLAUDE.md Constraints) must keep working, so it stays tracked.
public/sent_emails/*
!public/sent_emails/comm_1783454326531.html

# Security review write-ups that analyze STILL-DOWNLOADABLE old public release
# artifacts (v1.x-v2.0.1) at file:line — kept local-only so they do not become a
# public exploit guide for bundles that cannot be patched. Milestone-review reports
# for FIXED, never-shipped bugs remain tracked.
.planning/security/RELEASED-TAGS-REVIEW.md
.planning/security/HISTORY-SUPPLYCHAIN-REVIEW.md
